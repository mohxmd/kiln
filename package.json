{
  "name": "kiln-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun --filter kiln-compiler build",
    "check-types": "bun --filter kiln-compiler check-types",
    "test": "bun test packages/kiln/tests",
    "docs:dev": "bun --filter docs dev",
    "docs:build": "bun --filter docs build"
  }
}
