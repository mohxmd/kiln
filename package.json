{
  "name": "kiln",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check-types:test": "bun --filter kiln-compiler check-types:test",
    "check": "vp check && vp run -r check-types && bun run check-types:test",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "test": "bun test packages/kiln/tests",
    "docs:dev": "bun --filter docs dev",
    "docs:build": "bun --filter docs build"
  },
  "devDependencies": {
    "@kiln/config": "workspace:*",
    "@types/node": "^25.3.0",
    "rolldown": "1.2.6",
    "typescript": "^6.0.3",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
